# Copy to .env and fill in. Never commit .env.
#
# development | preview | production
# Non-production builds must point at a staging Supabase project with Stripe
# TEST keys. There is no staging yet — see docs/mobile/AUDIT.md §5.11.
EXPO_PUBLIC_APP_ENV=development

# Public values only (protected by RLS). Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web app origin — used for email confirmation links until the app's
# deep-link redirect (joggahub://auth/callback) is allowed in Supabase Auth.
EXPO_PUBLIC_WEB_URL=https://joggahub.com.br
