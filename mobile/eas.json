{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "preview" },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "testflight": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "preview" }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production" }
    }
  },
  "submit": {
    "testflight": {
      "ios": { "bundleIdentifier": "br.com.joggahub.app.preview", "appName": "JoggaHub (preview)" }
    },
    "production": {
      "ios": { "bundleIdentifier": "br.com.joggahub.app", "appName": "JoggaHub" }
    }
  }
}
